"""Model service for the team contract.

Start: gunicorn --bind 0.0.0.0:{{ port }} {{ app_target }}
Model: ${{ model_uri_env }}, else the last one {{ adapters_dir }}/train.py logged.
{{ predict_method }} {{ predict_path }}: one JSON record, features by name -> {"{{ prediction_field }}": ..., "{{ version_field }}": ...}
{{ health_method }} {{ health_path }}: 200 when the model is loaded.
Errors return 4xx (bad request) or 5xx (prediction failed), never 200.
"""
import json
import logging
import os
import uuid
from datetime import datetime, timezone
from pathlib import Path

import mlflow
import mlflow.{{ flavor }}
import numpy as np
import pandas as pd
{% if model_input == "dmatrix" %}
import xgboost as xgb
{% endif %}
from flask import Flask, jsonify, request

ROOT = Path(__file__).resolve().parents[{{ depth }}]

FEATURES = {{ features | py }}
MODEL_URI_ENV = {{ model_uri_env | py }}
MODEL_URI_FILE = {{ model_uri_file | py }}
PREDICTIONS_LOG = {{ predictions_log | py }}
PREDICTION_FIELD = {{ prediction_field | py }}
VERSION_FIELD = {{ version_field | py }}

log = logging.getLogger(__name__)


{% include "_model.py.j2" %}


MODEL_URI = model_uri()
MODEL = mlflow.{{ flavor }}.load_model(MODEL_URI)
MODEL_VERSION = model_version(MODEL_URI)

app = Flask(__name__)


class BadRequest(ValueError):
    pass


def parse_record(payload):
    """One record -> one-row DataFrame with the features by name, in training order."""
    if not isinstance(payload, dict):
        raise BadRequest("body must be one JSON object (one record)")
    missing = [f for f in FEATURES if f not in payload]
    if missing:
        raise BadRequest(f"missing features: {', '.join(missing)}")
    not_numeric = [f for f in FEATURES if not isinstance(payload[f], (int, float))]
    if not_numeric:
        raise BadRequest(f"features must be numbers or booleans: {', '.join(not_numeric)}")
    return pd.DataFrame([[payload[f] for f in FEATURES]], columns=FEATURES)


def log_prediction(features, prediction, request_id):
    line = {"time": datetime.now(timezone.utc).isoformat(), "model_version": MODEL_VERSION,
            "features": features, "prediction": prediction, "request_id": request_id}
    try:
        path = ROOT / PREDICTIONS_LOG
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as f:
            f.write(json.dumps(line) + "\n")
    except OSError:
        log.exception("could not write %s", PREDICTIONS_LOG)


@app.route({{ health_path | py }}, methods=[{{ health_method | py }}])
def health():
    return jsonify({"status": "ok", VERSION_FIELD: MODEL_VERSION}), 200


@app.route({{ predict_path | py }}, methods=[{{ predict_method | py }}])
def predict_endpoint():
    payload = request.get_json(silent=True)
    if payload is None:
        return jsonify({"error": "body must be JSON"}), 400
    try:
        X = parse_record(payload)
    except BadRequest as e:
        return jsonify({"error": str(e)}), 400
{% if task == "classification" %}
    try:
        value = predict(MODEL, X)[0]
        value = value.item() if hasattr(value, "item") else value   # numpy scalar -> int/float/str/bool
    except Exception as e:  # noqa: BLE001 - any model failure is a 500, never a 200
        log.exception("prediction failed")
        return jsonify({"error": f"prediction failed: {e}"}), 500
{% else %}
    try:
        value = float(predict(MODEL, X)[0])
    except Exception as e:  # noqa: BLE001 - any model failure is a 500, never a 200
        log.exception("prediction failed")
        return jsonify({"error": f"prediction failed: {e}"}), 500
    if not np.isfinite(value):
        return jsonify({"error": "prediction is not a finite number"}), 500
{% endif %}

    request_id = str(uuid.uuid4())
    log_prediction({f: payload[f] for f in FEATURES}, value, request_id)
    return jsonify({PREDICTION_FIELD: value, VERSION_FIELD: MODEL_VERSION, "request_id": request_id}), 200
